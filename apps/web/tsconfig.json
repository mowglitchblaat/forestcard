{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A browser app built by Vite: bundler resolution (imports without extensions, as shadcn writes
    // them), DOM types, JSX.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite-plus/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "test", "fx-preview/*.ts", "vite.config.ts"]
}
